# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env
*.pem
*.key

# Jupyter
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generic Data Directories
data/raw/*
data/interim/*
data/processed/*
data/incoming/*
!data/**/.gitkeep

# Component 2 Specific Data Rules
# 1. Block public benchmark datasets
data/c2_disease/public/
data/c2_disease/public/**
**/public/**
*.zip
*.tar.gz

# 2. Block raw camera/nursery images (keep folder structure via .gitkeep)
data/c2_disease/raw/
data/c2_disease/raw/**
!data/c2_disease/raw/**/.gitkeep

# 3. Block runtime uploads and dynamic triage telemetry
data/c2_disease/review_uploads/
data/c2_disease/review_uploads/**
data/c2_disease/telemetry.jsonl

# 4. Explicitly allow and track ground-truth manifests
!data/c2_disease/dataset_manifest.csv

# Models and Weights
/data/quality_assessment/original/
/data/quality_assessment/processed/
/data/quality_assessment/annotations/quality_dataset.xlsx

# Models and weights
models/checkpoints/*
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
!models/**/.gitkeep

# Component 2 Specific Model Rules
# 1. Exclude mutable triage queues
models/c2_disease/review_queue.json

# 2. Explicitly allow and track lightweight prototype stores
!models/c2_disease/prototypes.json
!models/c2_disease/prototype_support.json

# Vector store and experiment outputs
chroma_db/
experiments/logs/*
!experiments/logs/.gitkeep
wandb/
mlruns/

# DVC cache
/.dvc/cache

# Preprocessing & evaluation reports
services/c2_disease_detection/evaluation/reports/preprocessing_report.json
# Temporary files
~$*.xlsx
